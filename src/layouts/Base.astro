---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const siteName = 'Gurinder Raju';
const { title, description = 'Writing and talks by Gurinder Raju.', image } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
	{ href: '/posts/', label: 'Posts' },
	{ href: '/talks/', label: 'Talks' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonical} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title ?? siteName} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={image ? 'article' : 'website'} />
		{image && <meta property="og:image" content={new URL(image, Astro.site)} />}
	</head>
	<body>
		<header class="site wrap">
			<a class="name" href="/">{siteName}</a>
			<nav>
				{
					nav.map((item) => (
						<a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
							{item.label}
						</a>
					))
				}
			</nav>
		</header>
		<main class="wrap">
			<slot />
		</main>
		<footer class="site wrap meta">
			© {new Date().getFullYear()} {siteName}
		</footer>
	</body>
</html>
