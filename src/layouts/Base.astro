---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const siteName = 'Gurinder Raju';
const { title, description = 'Writing and talks by Gurinder Raju.', image } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isHome = path === '/';
const nav = [
	// The GitHub profile, whose README lists each repo with a line on what it is.
	{ href: 'https://github.com/gurinder-raju', label: 'Code' },
	{ href: '/posts/', label: 'Posts' },
	{ href: '/talks/', label: 'Talks' },
	{ href: 'https://www.linkedin.com/in/gurinder-raju/', label: 'LinkedIn' },
	{ href: 'https://x.com/gurinder_raju', label: 'X' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon.png" />
		<link rel="canonical" href={canonical} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={title ?? siteName} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:type" content={image ? 'article' : 'website'} />
		{image && <meta property="og:image" content={new URL(image, Astro.site)} />}
	</head>
	<body>
		<header class="site wrap">
			{/* The home page has no heading of its own, so the site name is its h1. */}
			{isHome ? <h1 class="name">{siteName}</h1> : <a class="name" href="/">{siteName}</a>}
			<nav>
				{
					nav.map((item, i) => (
						<>
							{i > 0 && <span aria-hidden="true">·</span>}
							<a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
								{item.label}
							</a>
						</>
					))
				}
			</nav>
		</header>
		<main class="wrap">
			<slot />
		</main>
	</body>
</html>
