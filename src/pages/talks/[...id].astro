---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getTalks, youtubeId } from '../../utils';

export async function getStaticPaths() {
	const talks = await getTalks();
	return talks.map((talk) => ({ params: { id: talk.id }, props: { talk } }));
}

const { talk } = Astro.props;
const { Content } = await render(talk);
const videoId = talk.data.youtube && youtubeId(talk.data.youtube);
const ogImage = talk.data.image && (await getImage({ src: talk.data.image, width: 1200, format: 'jpeg' }));
---

<Base title={talk.data.title} description={talk.data.description} image={ogImage ? ogImage.src : undefined}>
	<article>
		<h1>{talk.data.title}</h1>
		<div class="meta">
			{talk.data.event} ·{' '}
			<time datetime={talk.data.date.toISOString()}>
				{formatDate(talk.data.date, { year: 'numeric', month: 'long' })}
			</time>
		</div>
		{
			talk.data.image && (
				<Image
					class="hero"
					src={talk.data.image}
					alt={talk.data.imageAlt}
					widths={[400, 800, 1200]}
					sizes="(max-width: 48rem) 100vw, 46rem"
					loading="eager"
				/>
			)
		}
		{
			talk.data.books && (
				<ul class="books" aria-label="The books" style={`--books: ${talk.data.books.length}`}>
					{talk.data.books.map((book) => (
						<li>
							<a href={book.url} title={`${book.title}, ${book.author}`}>
								<Image src={book.cover} alt={`${book.title} by ${book.author}`} width={90} densities={[1, 2]} />
							</a>
						</li>
					))}
				</ul>
			)
		}
		<div class="body">
			<Content />
		</div>
		{
			videoId && (
				<figure class="video">
					<iframe
						src={`https://www.youtube-nocookie.com/embed/${videoId}`}
						title={`Video: ${talk.data.title}`}
						loading="lazy"
						allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
						referrerpolicy="strict-origin-when-cross-origin"
						allowfullscreen
					/>
					<figcaption class="meta">
						<a href={talk.data.youtube}>Watch on YouTube</a>
					</figcaption>
				</figure>
			)
		}
		{
			talk.data.deck && (
				<figure class="slides">
					<iframe src={talk.data.deck} title={`Slides: ${talk.data.title}`} loading="lazy" />
					<figcaption class="meta">
						Click or swipe through the slides, or <a href={talk.data.deck}>open them full screen</a>
					</figcaption>
				</figure>
			)
		}
	</article>
</Base>
