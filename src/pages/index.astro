---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import TalkList from '../components/TalkList.astro';
import { getPosts } from '../utils';

const latest = (await getPosts()).slice(0, 5);
---

<Base>
	<h1>Gurinder Raju</h1>
	<p><a href="https://www.linkedin.com/in/gurinder-raju/">LinkedIn</a></p>

	<h2>Latest posts</h2>
	<PostList posts={latest} />
	<a class="more" href="/posts/">All posts →</a>

	<h2>Talks</h2>
	<TalkList />
</Base>
