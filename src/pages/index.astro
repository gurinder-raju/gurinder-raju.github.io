---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import TalkList from '../components/TalkList.astro';
import { getPosts } from '../utils';

const latest = (await getPosts()).slice(0, 5);
---

<Base>
	<h2>Latest posts</h2>
	<PostList posts={latest} compact />
	<a class="more" href="/posts/">All posts →</a>

	<h2>Talks</h2>
	<TalkList compact />
</Base>
